{
  "name": "project-discovery",
  "productName": "Outline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test",
    "desktop": "npm run build && electron .",
    "package:win": "npm run build && electron-builder --win portable",
    "sign:local": "pwsh -NoProfile -File scripts/sign-local.ps1",
    "package:win:local": "npm run package:win && npm run sign:local"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "studio.bigsoy.outline",
    "electronDist": "node_modules/electron/dist",
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "directories": { "output": "release" },
    "win": { "target": "portable" },
    "artifactName": "Outline-${version}-portable.${ext}"
  }
}